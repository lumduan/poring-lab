# syntax=docker/dockerfile:1
# Build context: the repository root. The INTEL vision image (ADR-0022): bot-server's Arc A380.
# Selected by compose.intel.yaml, never by compose.yaml alone (VM 103's NVIDIA image stays the
# default there until the cutover).
#
# The packages are requirements-intel.txt, NOT uv.lock: the lock is CUDA-pinned (cu130). The
# requirements hold every package the lock also has at the lock's version
# (scripts/gen_intel_requirements.sh), so only the torch stack differs: torch 2.15.0+xpu and
# torchvision 0.29.2+xpu, plus OpenVINO 2026.4.1 for the live detector. Those are the versions
# proven on the Arc (docs/planning/bot-server-migration.md sections 14-15).
#
# The GPU's user-space driver comes from the same Ubuntu release as the host's kernel driver:
# Level Zero (libze1 + libze-intel-gpu1) for torch's XPU, OpenCL (intel-opencl-icd) for OpenVINO.
FROM ubuntu:26.04

COPY --from=ghcr.io/astral-sh/uv:0.12.20 /uv /uvx /bin/

# dpkg fsyncs every file it unpacks; a build layer is committed atomically afterwards, so unsafe-io
# is safe inside a build (kept from the CUDA image: the same rule for any shared disk).
RUN echo force-unsafe-io > /etc/dpkg/dpkg.cfg.d/docker-unsafe-io

# XCB libs for mss capture (+ MIT-SHM via memfd, + XFixes), as in the CUDA image; and the Intel
# GPU's compute runtime.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates libxcb1 libxcb-randr0 libxcb-render0 libxcb-shm0 libxcb-xfixes0 \
      libze1 libze-intel-gpu1 intel-opencl-icd ocl-icd-libopencl1 \
 && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PYTHON_PREFERENCE=only-managed \
    VIRTUAL_ENV=/opt/venv
RUN uv python install 3.12 && uv venv /opt/venv --python 3.12

# Every wheel by its pinned hash; --no-deps: the file IS the whole closure.
COPY services/vision/requirements-intel.txt /opt/requirements-intel.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_CONCURRENT_DOWNLOADS=2 UV_CONCURRENT_INSTALLS=1 \
    uv pip install --require-hashes --no-deps -r /opt/requirements-intel.txt \
      --extra-index-url https://download.pytorch.org/whl/xpu --index-strategy unsafe-best-match

# The two workspace members vision runs: poring_env and poring_vision (their dependencies are all
# in the requirements above). poring_packets and poring_dataset never enter this image (ADR-0007,
# ADR-0010; tests/test_guards.py), not even their pyproject.toml: no uv workspace here.
WORKDIR /app
COPY packages/poring_env packages/poring_env
COPY services/vision services/vision
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps ./packages/poring_env ./services/vision
COPY scripts/check_gpu.py scripts/check_gpu.py

# The ubuntu base ships a default `ubuntu` user at uid 1000 (the host user owning ./data).
RUN (userdel --remove ubuntu 2>/dev/null || true) \
 && useradd --uid 1000 --create-home --shell /usr/sbin/nologin agent
USER agent

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    DISPLAY=:99 \
    PORING_ACCEL=xpu \
    YOLO_CONFIG_DIR=/tmp/ultralytics
CMD ["poring-vision"]
