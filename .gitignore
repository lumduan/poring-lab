# ---- secrets --------------------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---- runtime data: datasets, captures, weights, input logs ------------------------------------------
# `data/` at ANY depth (this also covers a Ragnarok client's own data/ folder), except the root
# data/README.md. Order matters: re-include the root dir, ignore its contents, re-include the README.
**/data/
!/data/
/data/*
!/data/README.md

# ---- model weights / exports ------------------------------------------------------------------------
*.pt
*.pth
*.onnx
*.engine
*.safetensors
*.ckpt

# ---- Ragnarok Online client assets: NEVER commit game client files ---------------------------------
*.grf
*.gpf
*.exe
*.dll
*.lub
*.spr
*.act
*.rsw
*.gnd
*.gat
*.rsm
*.rsm2
*.str
*.imf
*.pal
*.bmp
*.tga
*.mp3
*.wav
*clientinfo*.xml

# ---- packet captures: RO login packets carry credentials -------------------------------------------
*.pcap
*.pcapng
*.pcap.gz

# ---- Python -----------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/

# ---- Node / Next.js ---------------------------------------------------------------------------------
node_modules/
.next/
out/
*.tsbuildinfo

# ---- editors / OS -----------------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/

# ---- generated at build time (scripts/gen_packet_tables.py; only the lock is committed) -----------
packages/poring_packets/src/poring_packets/_generated/
packages/poring_dataset/src/poring_dataset/_generated/

# ---- locale packs and extracted client text (ADR-0012): NEVER commit -----------------------------
# Packs are built from a developer's own client data by scripts/locale_pack.py and live OUTSIDE the
# repo (the NAS locale-packs/ share, /dev/shm). Only the builder and the schema are committed. The
# .githooks/pre-commit hook refuses the same paths (and pack strings) even when force-added.
locale-packs/
locales/
*.localepack/
/thai*/
**/ro_thai/
**/kro-reference/
**/grf-extract/
locale-pack.json
[mM][sS][gG][sS][tT][rR][iI][nN][gG][tT][aA][bB][lL][eE]*.[tT][xX][tT]
