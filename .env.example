# poring-lab configuration. Copy to .env (gitignored) -- easiest: scripts/init_env.sh, which also
# fills every empty secret below with a random value and detects HOST_LAN_IP.
# NEVER commit .env.

# --- Network ------------------------------------------------------------------------------------
# This Docker host's LAN IP. Published ports bind to it, and rathena ADVERTISES it to game clients
# as the char/map address (the container IP would break every LAN client right after login).
HOST_LAN_IP=192.168.1.13

# --- Windows host: the RO client + the ONE interactive RDP session ------------------------------
# Leave WIN_HOST/RDP_USER/RDP_PASSWORD empty to run Xvfb-only (no RDP connection is attempted).
# Connecting locks the Windows console and kicks whoever is logged in there.
WIN_HOST=
RDP_PORT=3389
# The lab's own STANDARD Windows account (2026-10-01; docs/client/rathena-client.md "Windows
# account"): RDP_USER/RDP_PASSWORD = WIN_LAB_USER/WIN_LAB_PASSWORD. Never an administrator: elevation
# is the operator's (UAC). scripts/rotate_secrets.py rotate WIN_LAB_PASSWORD generates it.
WIN_LAB_USER=
WIN_LAB_PASSWORD=
RDP_USER=
# Must not contain a newline (passed to xfreerdp3 line-by-line via stdin, never via argv).
RDP_PASSWORD=
RDP_DOMAIN=
# SHA-256 of the Windows RDP certificate: `python3 scripts/rdp_cert_fingerprint.py <WIN_HOST>`.
# Empty => /cert:ignore + warning. Windows renews its self-signed cert ~every 6 months: re-pin then.
RDP_CERT_SHA256=
# Empty = FreeRDP autodetect (GFX + AVC444 + RFX). Alternatives: progressive | AVC444 | AVC420 | RFX |
# off (legacy lossless bitmap codecs) | AVCthin (10.3 AVC thin-client caps). The lab runs
# `progressive` (2026-10-01, docs/h264-plan.md): with the Windows AVC policies on, autodetect gets
# AVC444 and AVCthin gets full-screen AVC. On xfreerdp 3.32.1 (Arm C) progressive and AVCthin both
# deliver 30 fps; AVCthin costs ~1/5 of the CPU but is lossy, so progressive stays the default.
RDP_GFX=progressive
# Human-only clipboard + file transfer (ADR-0004), by KEYWORD. Both OFF by default; applying a change
# recreates desktop + backend together (one RDP reconnect): scripts/dev.sh up -d --no-deps desktop backend
#   RDP_CLIPBOARD: off | text-to-remote  (text Mac -> Windows only; Windows -> X and file clipboard off)
#   RDP_DRIVES:    "" | transfer         (the 512 MiB tmpfs volume, seen in Windows as \\tsclient\transfer)
RDP_CLIPBOARD=off
RDP_DRIVES=
# Browser stream capture (docs/phase0-latency.md): damage = grab when the screen changes (XDamage),
# at most STREAM_MAX_FPS per second; fixed = a STREAM_FPS slot grid (the pre-2026-09-30 behaviour).
STREAM_CAPTURE=damage
STREAM_MAX_FPS=60

# --- Display --------------------------------------------------------------------------------------
# SESSION_SIZE: the Windows session (RDP /size, the console stream), drawn 1:1 at the canvas'
# top-left. 1440x900 holds the RO client's 1296x759 window (a 1:1 1280x720 client area, frozen for
# Phase 2) above the taskbar: docs/client/rathena-client.md. The stream, the agent's frames and the
# input mapping all use this area. Empty = the whole Xvfb screen (the pre-2026-10-02 layout).
# XVFB_RESOLUTION: the canvas. Larger than the session so Moonlight's console-mode window opens at
# native size: it must exceed the session by 25 % in both directions (Moonlight caps a window at
# 80 % of the screen), and 1920x1200 does (ADR-0009 amendment, 2026-10-02).
XVFB_RESOLUTION=1920x1200x24
SESSION_SIZE=1440x900
# noVNC has NO authentication. false = interactive (unlogged input that bypasses the mux).
NOVNC_VIEW_ONLY=true

# --- Database (MariaDB) ---------------------------------------------------------------------------
DB_NAME=ragnarok
DB_USER=ragnarok
# [A-Za-z0-9_.-]{4,64} only (rAthena's conf parser takes the rest of the line verbatim).
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- rAthena ---------------------------------------------------------------------------------------
# Must match the RO client executable's date: 20211103 = the 2021-11-03 kRO client (docs/client/).
# Changing it (or PRERE) requires a rebuild, through the IO guard:
#   python3 scripts/guarded_build.py --sustain 30 --spike 25 build:rathena
PACKETVER=20211103
# yes = pre-renewal (Batt, 2026-09-30: the Ragnarok Classic ruleset the lab's research targets).
RATHENA_PRERE=yes
RATHENA_VIP=no
# rAthena has no releases; pin a full commit SHA.
RATHENA_REF=e985006171d2eb320ee512a653f4c83aea3d81b6
RATHENA_MAKE_JOBS=4
# Inter-server account (replaces the insecure s1/p1). [A-Za-z0-9_.-]{4,23}: rAthena keeps it in
# 24-byte buffers and silently truncates longer values (login then rejects char/map).
RATHENA_SERVER_USER=
RATHENA_SERVER_PASSWORD=
RATHENA_SERVER_NAME=PoringLab
# yes: create accounts from the client login screen with a _M / _F suffix.
RATHENA_NEW_ACCOUNT=yes
RATHENA_PINCODE=no
# true: start rAthena's web-server (the 2021 client loads / saves its account and character UI
# settings there, at its AssistAddr; published on HOST_LAN_IP:8888). The lab runs it since
# 2026-11-05; false leaves the client printing "error when loading the data account settings".
RATHENA_WEB_SERVER=false
# Optional test player account, upserted at every rathena start (scripts/init_env.sh generates it).
# User: 4-23 of [A-Za-z0-9_]; password: 8-32 of [A-Za-z0-9]. Type them at the client login yourself.
RATHENA_TEST_USER=
RATHENA_TEST_PASSWORD=
# The agent's accounts (scripts/init_env.sh generates them; docs/client/rathena-client.md). Same
# charsets as above. scripts/ro_agent.py logs in with them as sensitive input -- never printed.
#   AGENT: a plain player (group 0) for login/recovery/measurement moves.
#   GM:    group 20 "Validation" (where, who, whomap, mapmove, mobsearch, monster, killmonster2,
#          hide; every command logged) for Phase 1 ground-truth checks ONLY. Its sessions are
#          tagged validation_account by the sniffer (VALIDATION_USERIDS) and kept out of datasets.
RATHENA_AGENT_USER=
RATHENA_AGENT_PASSWORD=
RATHENA_GM_USER=
RATHENA_GM_PASSWORD=
# Character names the agent creates on those accounts (4-23 of [A-Za-z0-9]; not secrets).
RATHENA_AGENT_CHAR=
RATHENA_GM_CHAR=

# --- The Thai-data experiment (2026-10-05): rathena-th + db-th + sniffer-th (compose profile th).
# One at a time with rathena. Generated first-time only (never typed):
#   python3 scripts/rotate_secrets.py rotate DB_TH_PASSWORD DB_TH_ROOT_PASSWORD \
#     RATHENA_TH_SERVER_USER RATHENA_TH_SERVER_PASSWORD RATHENA_TH_AGENT_USER \
#     RATHENA_TH_AGENT_PASSWORD RATHENA_TH_GM_USER RATHENA_TH_GM_PASSWORD
DB_TH_NAME=ragnarok
DB_TH_USER=ragnarok
DB_TH_PASSWORD=
DB_TH_ROOT_PASSWORD=
RATHENA_TH_SERVER_USER=
RATHENA_TH_SERVER_PASSWORD=
RATHENA_TH_SERVER_NAME=PoringLab-TH
RATHENA_TH_TEST_USER=
RATHENA_TH_TEST_PASSWORD=
RATHENA_TH_AGENT_USER=
RATHENA_TH_AGENT_PASSWORD=
RATHENA_TH_GM_USER=
RATHENA_TH_GM_PASSWORD=
RATHENA_TH_AGENT_CHAR=
RATHENA_TH_GM_CHAR=

# --- Backend ---------------------------------------------------------------------------------------
# Browser WebSocket Origin allowlist, comma-separated. Empty => http://${HOST_LAN_IP}:3000.
# Add http://localhost:3000 when running `pnpm dev` on a workstation.
FRONTEND_ORIGINS=
ASSIST_LEASE_S=3.0
STREAM_FPS=30
JPEG_QUALITY=80
CAPTURE_WITH_CURSOR=false
# Black-screen detector (/health game_display, the console banner): the RO client area in desktop
# pixels "x,y,w,h" (empty = whole frame: only a fully black desktop trips it), and how long it
# must stay black.
GAME_REGION=
BLACK_HOLD_S=5
# S2 frame bus (docs/s2-plan.md): the console's JPEG rate while it reads decoded stream frames.
CONSOLE_FPS=15
# Experiment C1 (raw H.264 datasets, docs/benchmarks/h264-vs-png.md): the HOST dir the S2 client
# records its bitstream into (compose.dev.yaml mounts it at /s2-rec in gamestream, rw: its only
# writable bind). Dot-named so dataset_ship never lists it; must exist, owned by uid 1000. Empty =
# /home/batt/poring-lab-rec/.s2-h264 (record_session.py reads the same variable).
S2_REC_DIR=
# scripts/ro_agent.py, per Windows account desktop: the "Ragnarok Offline" shortcut icon centre
# "x,y", and a box "x,y,w,h" containing the tray's ENG/ไทย indicator (calibration only; the check
# slides along the tray).
RO_SHORTCUT=
RO_TRAY_LANG=
# The agent's own NON-elevated terminal: the "poring-lab shell" desktop shortcut's icon centre
# "x,y" (ro_agent.py open-terminal; Batt, 2026-10-03).
SHELL_SHORTCUT=

# --- Vision (GPU) ------------------------------------------------------------------------------------
AGENT_HZ=10
# ADR-0022: this host's profile (scripts/host_profile.py). Empty = shared-nvidia, ubuntu-docker: R1-R3
# and the IO guard apply. bot-server: dedicated-intel (the Intel vision image through
# compose.intel.yaml / compose.vision-worker.intel.yaml; no shared-host rules), with
# VISION_MAX_VRAM_FRACTION=1.0 (nothing else on its GPU).
LAB_HOST_PROFILE=
# The host's `render` group id (`getent group render`): the Intel image's /dev/dri access. Empty = 991.
RENDER_GID=
VISION_MAX_VRAM_FRACTION=0.25
VISION_DEBUG_BOX=false
