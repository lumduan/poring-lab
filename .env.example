# poring-lab configuration. Copy to .env (gitignored) -- easiest: scripts/init_env.sh, which also
# fills every empty secret below with a random value and detects HOST_LAN_IP.
# NEVER commit .env.

# --- Network ------------------------------------------------------------------------------------
# This Docker host's LAN IP. Published ports bind to it, and rathena ADVERTISES it to game clients
# as the char/map address (the container IP would break every LAN client right after login).
HOST_LAN_IP=192.168.1.13

# --- Windows host: the RO client + the ONE interactive RDP session ------------------------------
# Leave WIN_HOST/RDP_USER/RDP_PASSWORD empty to run Xvfb-only (no RDP connection is attempted).
# Connecting locks the Windows console and kicks whoever is logged in there.
WIN_HOST=
RDP_PORT=3389
RDP_USER=
# Must not contain a newline (passed to xfreerdp3 line-by-line via stdin, never via argv).
RDP_PASSWORD=
RDP_DOMAIN=
# SHA-256 of the Windows RDP certificate: `python3 scripts/rdp_cert_fingerprint.py <WIN_HOST>`.
# Empty => /cert:ignore + warning. Windows renews its self-signed cert ~every 6 months: re-pin then.
RDP_CERT_SHA256=
# Empty = FreeRDP autodetect (GFX + AVC444 + RFX). Phase-0 alternatives: progressive | AVC444 |
# AVC420 | RFX | off (legacy lossless bitmap codecs).
RDP_GFX=
# Human-only clipboard + file transfer (ADR-0004), by KEYWORD. Both OFF by default; applying a change
# recreates desktop + backend together (one RDP reconnect): scripts/dev.sh up -d --no-deps desktop backend
#   RDP_CLIPBOARD: off | text-to-remote  (text Mac -> Windows only; Windows -> X and file clipboard off)
#   RDP_DRIVES:    "" | transfer         (the 512 MiB tmpfs volume, seen in Windows as \\tsclient\transfer)
RDP_CLIPBOARD=off
RDP_DRIVES=
# Browser stream capture (docs/phase0-latency.md): damage = grab when the screen changes (XDamage),
# at most STREAM_MAX_FPS per second; fixed = a STREAM_FPS slot grid (the pre-2026-09-30 behaviour).
STREAM_CAPTURE=damage
STREAM_MAX_FPS=60

# --- Display --------------------------------------------------------------------------------------
# Xvfb screen = RDP session size. Set the RO client on Windows to the same resolution.
XVFB_RESOLUTION=1280x720x24
# noVNC has NO authentication. false = interactive (unlogged input that bypasses the mux).
NOVNC_VIEW_ONLY=true

# --- Database (MariaDB) ---------------------------------------------------------------------------
DB_NAME=ragnarok
DB_USER=ragnarok
# [A-Za-z0-9_.-]{4,64} only (rAthena's conf parser takes the rest of the line verbatim).
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- rAthena ---------------------------------------------------------------------------------------
# Must match the RO client executable's date. Changing it (or PRERE) requires a rebuild:
#   docker compose --profile core build rathena
PACKETVER=20211103
RATHENA_PRERE=no
RATHENA_VIP=no
# rAthena has no releases; pin a full commit SHA.
RATHENA_REF=e985006171d2eb320ee512a653f4c83aea3d81b6
RATHENA_MAKE_JOBS=4
# Inter-server account (replaces the insecure s1/p1). [A-Za-z0-9_.-]{4,64}.
RATHENA_SERVER_USER=
RATHENA_SERVER_PASSWORD=
RATHENA_SERVER_NAME=PoringLab
# yes: create accounts from the client login screen with a _M / _F suffix.
RATHENA_NEW_ACCOUNT=yes
RATHENA_PINCODE=no
RATHENA_WEB_SERVER=false

# --- Backend ---------------------------------------------------------------------------------------
# Browser WebSocket Origin allowlist, comma-separated. Empty => http://${HOST_LAN_IP}:3000.
# Add http://localhost:3000 when running `pnpm dev` on a workstation.
FRONTEND_ORIGINS=
ASSIST_LEASE_S=3.0
STREAM_FPS=30
JPEG_QUALITY=80
CAPTURE_WITH_CURSOR=false

# --- Vision (GPU) ------------------------------------------------------------------------------------
AGENT_HZ=10
VISION_MAX_VRAM_FRACTION=0.25
VISION_DEBUG_BOX=false
