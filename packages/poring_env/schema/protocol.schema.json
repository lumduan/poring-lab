{
  "$defs": {
    "AgentHello": {
      "additionalProperties": false,
      "description": "First message on /internal/agent.",
      "properties": {
        "agent_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "agent_hello",
          "default": "agent_hello",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "agent_id",
        "version"
      ],
      "title": "AgentHello",
      "type": "object"
    },
    "AgentInput": {
      "additionalProperties": false,
      "description": "A batch of bot input decided on ``frame_id`` (captured at ``t_capture_ns``).",
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/InputEvent"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "t_capture_ns": {
          "minimum": 0,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "agent_input",
          "default": "agent_input",
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "t_capture_ns",
        "events"
      ],
      "title": "AgentInput",
      "type": "object"
    },
    "AgentToBackend": {
      "discriminator": {
        "mapping": {
          "agent_hello": "#/$defs/AgentHello",
          "agent_input": "#/$defs/AgentInput",
          "detections": "#/$defs/Detections",
          "ping": "#/$defs/Ping"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AgentHello"
        },
        {
          "$ref": "#/$defs/AgentInput"
        },
        {
          "$ref": "#/$defs/Detections"
        },
        {
          "$ref": "#/$defs/Ping"
        }
      ]
    },
    "BackendToAgent": {
      "discriminator": {
        "mapping": {
          "error": "#/$defs/ErrorReply",
          "input_ack": "#/$defs/InputAck",
          "pong": "#/$defs/Pong",
          "status": "#/$defs/Status"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Status"
        },
        {
          "$ref": "#/$defs/InputAck"
        },
        {
          "$ref": "#/$defs/Pong"
        },
        {
          "$ref": "#/$defs/ErrorReply"
        }
      ]
    },
    "BackendToBrowser": {
      "discriminator": {
        "mapping": {
          "detections": "#/$defs/Detections",
          "error": "#/$defs/ErrorReply",
          "frame": "#/$defs/FrameMeta",
          "paste_result": "#/$defs/PasteResult",
          "pong": "#/$defs/Pong",
          "status": "#/$defs/Status"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FrameMeta"
        },
        {
          "$ref": "#/$defs/Status"
        },
        {
          "$ref": "#/$defs/Detections"
        },
        {
          "$ref": "#/$defs/Pong"
        },
        {
          "$ref": "#/$defs/PasteResult"
        },
        {
          "$ref": "#/$defs/ErrorReply"
        }
      ]
    },
    "Box": {
      "additionalProperties": false,
      "description": "One detection, corners normalized to [0, 1].",
      "properties": {
        "cls": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "conf": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "x1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "x2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "y1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "y2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2",
        "cls",
        "conf"
      ],
      "title": "Box",
      "type": "object"
    },
    "BrowserToBackend": {
      "discriminator": {
        "mapping": {
          "clipboard_paste": "#/$defs/ClipboardPaste",
          "key": "#/$defs/Key",
          "mouse_button": "#/$defs/MouseButton",
          "mouse_move": "#/$defs/MouseMove",
          "ping": "#/$defs/Ping",
          "release_all": "#/$defs/ReleaseAll",
          "set_mode": "#/$defs/SetMode",
          "wheel": "#/$defs/Wheel"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MouseMove"
        },
        {
          "$ref": "#/$defs/MouseButton"
        },
        {
          "$ref": "#/$defs/Wheel"
        },
        {
          "$ref": "#/$defs/Key"
        },
        {
          "$ref": "#/$defs/ReleaseAll"
        },
        {
          "$ref": "#/$defs/SetMode"
        },
        {
          "$ref": "#/$defs/Ping"
        },
        {
          "$ref": "#/$defs/ClipboardPaste"
        }
      ]
    },
    "ClipboardPaste": {
      "additionalProperties": false,
      "description": "Paste this text into the focused Windows window (ADR-0004: human-only, browser channel only).\n\nThe backend owns the X CLIPBOARD for the duration of one paste, sends Ctrl+V through the mux and\nanswers with a ``PasteResult``. The text itself is never logged.",
      "properties": {
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "request_id": {
          "description": "Echoed in the PasteResult.",
          "minimum": 0,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "description": "At most 65536 bytes once UTF-8 encoded.",
          "maxLength": 65536,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "clipboard_paste",
          "default": "clipboard_paste",
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "request_id",
        "text"
      ],
      "title": "ClipboardPaste",
      "type": "object"
    },
    "Detections": {
      "additionalProperties": false,
      "description": "Detections computed on ``frame_id`` (the agent's own grab); relayed to viewers as overlay.",
      "properties": {
        "boxes": {
          "items": {
            "$ref": "#/$defs/Box"
          },
          "maxItems": 512,
          "type": "array"
        },
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "t_capture_ns": {
          "minimum": 0,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "detections",
          "default": "detections",
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "t_capture_ns",
        "boxes"
      ],
      "title": "Detections",
      "type": "object"
    },
    "ErrorReply": {
      "additionalProperties": false,
      "description": "A message from this sender was dropped: it failed validation or could not be read.\n\nNever silent (ADR-0004 decision 4): the drop is also logged and counted in /health.",
      "properties": {
        "channel": {
          "enum": [
            "ws_input",
            "ws_stream",
            "agent"
          ],
          "type": "string"
        },
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "reason": {
          "description": "e.g. missing:key.t_mono_ns, json_invalid.",
          "maxLength": 128,
          "type": "string"
        },
        "ref_type": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The dropped message's type, if readable."
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "error",
          "default": "error",
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "channel",
        "reason",
        "ref_type"
      ],
      "title": "ErrorReply",
      "type": "object"
    },
    "FrameMeta": {
      "additionalProperties": false,
      "description": "Sent immediately before exactly one binary WebSocket message holding this frame's JPEG.",
      "properties": {
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "nbytes": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "t_capture_ns": {
          "minimum": 0,
          "type": "integer"
        },
        "t_encoded_ns": {
          "minimum": 0,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "frame",
          "default": "frame",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "t_capture_ns",
        "t_encoded_ns",
        "width",
        "height",
        "nbytes"
      ],
      "title": "FrameMeta",
      "type": "object"
    },
    "InputAck": {
      "additionalProperties": false,
      "description": "Mux verdict for one AgentInput batch.",
      "properties": {
        "accepted": {
          "minimum": 0,
          "type": "integer"
        },
        "dropped": {
          "minimum": 0,
          "type": "integer"
        },
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "input_ack",
          "default": "input_ack",
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "accepted",
        "dropped",
        "reasons"
      ],
      "title": "InputAck",
      "type": "object"
    },
    "InputEvent": {
      "discriminator": {
        "mapping": {
          "key": "#/$defs/Key",
          "mouse_button": "#/$defs/MouseButton",
          "mouse_move": "#/$defs/MouseMove",
          "release_all": "#/$defs/ReleaseAll",
          "wheel": "#/$defs/Wheel"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MouseMove"
        },
        {
          "$ref": "#/$defs/MouseButton"
        },
        {
          "$ref": "#/$defs/Wheel"
        },
        {
          "$ref": "#/$defs/Key"
        },
        {
          "$ref": "#/$defs/ReleaseAll"
        }
      ]
    },
    "Key": {
      "additionalProperties": false,
      "description": "A physical key named by KeyboardEvent.code -- layout-independent (see keymap.py).",
      "properties": {
        "action": {
          "enum": [
            "down",
            "up"
          ],
          "type": "string"
        },
        "code": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9]+$",
          "type": "string"
        },
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "key",
          "default": "key",
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "code",
        "action"
      ],
      "title": "Key",
      "type": "object"
    },
    "Mode": {
      "description": "Input-mux mode (ADR-0002). The backend always boots in HUMAN.",
      "enum": [
        "HUMAN",
        "BOT",
        "ASSIST"
      ],
      "title": "Mode",
      "type": "string"
    },
    "MouseButton": {
      "additionalProperties": false,
      "description": "Button press or release. With x/y the pointer moves there first; without them (null) the\nbutton acts wherever the pointer already is -- used for the mux's synthetic releases, which\nmust never yank the pointer away from whoever now controls it.",
      "properties": {
        "action": {
          "enum": [
            "down",
            "up"
          ],
          "type": "string"
        },
        "button": {
          "enum": [
            "left",
            "middle",
            "right"
          ],
          "type": "string"
        },
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "mouse_button",
          "default": "mouse_button",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "y": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "button",
        "action",
        "x",
        "y"
      ],
      "title": "MouseButton",
      "type": "object"
    },
    "MouseMove": {
      "additionalProperties": false,
      "description": "Absolute pointer move; x/y are normalized to [0, 1] over the captured screen.",
      "properties": {
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "mouse_move",
          "default": "mouse_move",
          "type": "string"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "x",
        "y"
      ],
      "title": "MouseMove",
      "type": "object"
    },
    "PasteResult": {
      "additionalProperties": false,
      "description": "Outcome of one ClipboardPaste. ``reason`` is \"ok\" or why it was refused or failed.",
      "properties": {
        "chars": {
          "description": "Characters offered to Windows (0 when refused).",
          "minimum": 0,
          "type": "integer"
        },
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "ok": {
          "type": "boolean"
        },
        "reason": {
          "maxLength": 64,
          "type": "string"
        },
        "request_id": {
          "minimum": 0,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "paste_result",
          "default": "paste_result",
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "request_id",
        "ok",
        "reason",
        "chars"
      ],
      "title": "PasteResult",
      "type": "object"
    },
    "Ping": {
      "additionalProperties": false,
      "description": "Round-trip probe; its ``t_mono_ns`` comes back verbatim as ``Pong.echo_t_mono_ns``.",
      "properties": {
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "ping",
          "default": "ping",
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type"
      ],
      "title": "Ping",
      "type": "object"
    },
    "Pong": {
      "additionalProperties": false,
      "description": "Answer to a Ping. ``t_mono_ns`` is the backend clock; the echo is the pinger's clock.",
      "properties": {
        "echo_t_mono_ns": {
          "minimum": 0,
          "type": "integer"
        },
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "pong",
          "default": "pong",
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "echo_t_mono_ns"
      ],
      "title": "Pong",
      "type": "object"
    },
    "ReleaseAll": {
      "additionalProperties": false,
      "description": "Release every key and button the sender holds (browser blur, agent reset).",
      "properties": {
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "release_all",
          "default": "release_all",
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type"
      ],
      "title": "ReleaseAll",
      "type": "object"
    },
    "SetMode": {
      "additionalProperties": false,
      "description": "Switch the input mux (HUMAN / BOT / ASSIST).",
      "properties": {
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "set_mode",
          "default": "set_mode",
          "type": "string"
        }
      },
      "required": [
        "t_mono_ns",
        "frame_id",
        "type",
        "mode"
      ],
      "title": "SetMode",
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Mux and pipeline state, pushed at ~1 Hz and on every change.",
      "properties": {
        "bot_connected": {
          "type": "boolean"
        },
        "capture_fps": {
          "minimum": 0.0,
          "type": "number"
        },
        "clipboard_enabled": {
          "default": false,
          "description": "Clipboard paste to Windows is available (ADR-0004).",
          "type": "boolean"
        },
        "frame_id": {
          "default": -1,
          "description": "Frame this message refers to or was produced from; -1 means none.",
          "minimum": -1,
          "type": "integer"
        },
        "lease_until_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End of the ASSIST human lease (backend clock); null = none."
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "rdp_window_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An xfreerdp window exists on the display; null = X unreachable."
        },
        "t_mono_ns": {
          "description": "Sender's monotonic clock, ns (see module docstring).",
          "minimum": 0,
          "type": "integer"
        },
        "transfer_enabled": {
          "default": false,
          "description": "The \\\\tsclient\\transfer file area is available (ADR-0004).",
          "type": "boolean"
        },
        "type": {
          "const": "status",
          "default": "status",
